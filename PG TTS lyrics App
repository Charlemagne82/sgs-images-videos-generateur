var tx=d.transaction(['songs','audio'],'readwrite');
tx.objectStore('songs').delete(id);
tx.objectStore('audio').delete(id);
tx.oncomplete=function(){resolve()};
tx.onerror=function(){reject(tx.error)};
})});
}
