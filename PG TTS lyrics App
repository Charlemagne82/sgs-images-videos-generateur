document.getElementById('bdel').onclick=delSong;
document.getElementById('btranscribe').onclick=transcribe;
document.getElementById('audio-up').onclick=function(){document.getElementById('f-audio').click()};
document.getElementById('f-audio').onchange=function(e){
var f=e.target.files[0];if(!f)return;
if(f.size>MAX_AUDIO_SIZE){toast('Trop lourd (max 24 Mo)','error');e.target.value='';return}
editAudioBlob=f;
updAudioUI();
toast('Audio ajouté ✓');
e.target.value='';
};
document.getElementById('pback').onclick=closePlayer;
document.getElementById('pedit').onclick=function(){if(cur)openModal(cur)};
document.getElementById('bplay').onclick=function(){
if(useWA&&buf){if(waState.playing)pauseWA();else playWA()}
else{var a=document.getElementById('audio');if(!a.src){toast('Aucun audio','warn');return}if(a.paused)a.play().catch(function(){});else a.pause()}
};
document.getElementById('brewind').onclick=function(){
if(useWA&&ac){waState.paused=Math.max(0,waState.paused-5);if(waState.playing){pauseWA();playWA()}else updProg(waState.paused,waState.dur)}
else{var a=document.getElementById('audio');a.currentTime=Math.max(0,a.currentTime-5)}
};
document.getElementById('bforward').onclick=function(){
if(useWA&&ac){waState.paused=Math.min(waState.dur,waState.paused+5);if(waState.playing){pauseWA();playWA()}else updProg(waState.paused,waState.dur)}
else{var a=document.getElementById('audio');a.currentTime=Math.min(a.duration||0,a.currentTime+5)}
};
document.querySelectorAll('.speed-btn').forEach(function(b){
b.onclick=function(){
var s=parseFloat(b.dataset.speed);
document.getElementById('audio').playbackRate=s;
document.querySelectorAll('.speed-btn').forEach(function(x){x.className='speed-btn'});
b.className='speed-btn active';
};
});
document.querySelectorAll('.export-btn').forEach(function(b){
b.onclick=function(){
var f=b.dataset.format;
if(f==='pdf')exportPDF();
else if(f==='word')exportWord();
else if(f==='gdocs')exportGDocs();
};
});
document.getElementById('bdown').onclick=function(){metro.bpm=Math.max(40,metro.bpm-1);document.getElementById('bval').textContent=metro.bpm;document.getElementById('brange').value=metro.bpm};
document.getElementById('bup').onclick=function(){metro.bpm=Math.min(240,metro.bpm+1);document.getElementById('bval').textContent=metro.bpm;document.getElementById('brange').value=metro.bpm};
document.getElementById('brange').oninput=function(e){metro.bpm=parseInt(e.target.value,10);document.getElementById('bval').textContent=metro.bpm};
document.getElementById('mstart').onclick=function(){if(metro.on)stopMetro();else startMetro()};
document.getElementById('pbar').onclick=function(e){
var r=e.currentTarget.getBoundingClientRect();
var p=(e.clientX-r.left)/r.width;
if(useWA&&ac){waState.paused=p*waState.dur;if(waState.playing){pauseWA();playWA()}else updProg(waState.paused,waState.dur)}
else{var a=document.getElementById('audio');if(a.duration)a.currentTime=p*a.duration}
};
var ael=document.getElementById('audio');
ael.onplay=updPlay;ael.onpause=updPlay;
ael.onloadedmetadata=function(){if(!useWA)updProg(ael.currentTime,ael.duration)};
ael.ontimeupdate=function(){if(!useWA)updProg(ael.currentTime,ael.duration)};
ael.onended=updPlay;

