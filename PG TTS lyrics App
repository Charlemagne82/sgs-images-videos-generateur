catch(e){console.warn('Migration audio échouée',s.id,e)}
}
}).then(function(){count++}).catch(function(e){console.warn('Migration chant échouée',s.id,e)});
});
},Promise.resolve()).then(function(){
localStorage.setItem(MIG_FLAG,'1');
if(count>0)setTimeout(function(){toast(count+' chants migrés vers le stockage rapide','success')},500);
});
}

