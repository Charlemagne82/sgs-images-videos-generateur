function parseLyrics(lyrics){
return String(lyrics||'').split('\n').map(function(line){
var t=line.trim();
if(!t)return{type:'blank',text:''};
if(/^Lead\s*:/i.test(t))return{type:'lead',text:t};
if(/^Chœurs?\s*:/i.test(t)||/^Choeurs?\s*:/i.test(t))return{type:'choir',text:t};
return{type:'normal',text:t};
});
}
function lyricsToHTML(lyrics){
return parseLyrics(lyrics).map(function(l){
if(l.type==='lead')return'<p style="color:#1e40af;font-weight:bold;margin:6pt 0">'+esc(l.text)+'</p>';
if(l.type==='choir')return'<p style="color:#b45309;font-style:italic;margin:6pt 0">'+esc(l.text)+'</p>';
if(l.type==='blank')return'<div style="height:6pt"></div>';
return'<p style="margin:6pt 0">'+esc(l.text)+'</p>';
}).join('');
}

