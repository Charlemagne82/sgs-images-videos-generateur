try{parsed=JSON.parse(raw)}catch(e){localStorage.setItem(MIG_FLAG,'1');return Promise.resolve()}
if(!parsed||!parsed.length){localStorage.setItem(MIG_FLAG,'1');return Promise.resolve()}
var count=0;
return parsed.reduce(function(p,s){
