<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Puissant Gospels TV</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,sans-serif;background:#0f172a;color:#f1f5f9;min-height:100vh;padding:1rem;font-size:15px;line-height:1.5;max-width:780px;margin:0 auto}
header{text-align:center;padding:.5rem 0 1rem;position:relative}
h1{font-size:1.5rem;color:#facc15;margin-bottom:.2rem}
.subtitle{font-size:.8rem;color:#94a3b8;font-style:italic}
.settings-icon{position:absolute;top:.5rem;right:0;background:#1e293b;border:1px solid #334155;color:#f1f5f9;width:40px;height:40px;border-radius:50%;font-size:1.1rem;cursor:pointer}
.search-bar{position:sticky;top:.5rem;z-index:50;background:#1e293b;border:1px solid #334155;border-radius:14px;padding:.5rem .8rem;display:flex;align-items:center;gap:.6rem;margin-bottom:1rem}
.search-bar input{flex:1;background:transparent;border:none;color:#f1f5f9;font-family:inherit;font-size:.95rem;outline:none;padding:.4rem 0}
.search-bar input::placeholder{color:#64748b}
.tabs{display:flex;gap:.4rem;margin-bottom:1rem;background:#1e293b;padding:.3rem;border-radius:14px;border:1px solid #334155}
.tab{flex:1;padding:.6rem .5rem;text-align:center;border-radius:10px;font-size:.8rem;font-weight:600;cursor:pointer;color:#94a3b8;user-select:none}
.tab.active{background:#facc15;color:#0f172a}
.songs-list{display:flex;flex-direction:column;gap:.6rem}
.song-card{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:.9rem 1rem;cursor:pointer;display:flex;align-items:center;gap:.9rem;content-visibility:auto;contain-intrinsic-size:auto 70px}
.song-card:active{border-color:#facc15}
.song-card .cover{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#facc15,#fbbf24);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;color:#0f172a}
.song-card .info{flex:1;min-width:0}
.song-card .title{font-size:.95rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.song-card .meta{font-size:.75rem;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.song-card .fav-btn{background:transparent;border:none;color:#64748b;font-size:1.3rem;cursor:pointer;padding:.3rem;flex-shrink:0}
.song-card .fav-btn.active{color:#facc15}
.empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.9rem}
.empty .emoji{font-size:3rem;margin-bottom:1rem;opacity:.6}
.empty .title{font-size:1rem;color:#f1f5f9;margin-bottom:.4rem;font-weight:600}
.fab{position:fixed;bottom:1.5rem;right:1.5rem;width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#facc15,#fbbf24);color:#0f172a;border:none;font-size:1.8rem;cursor:pointer;box-shadow:0 8px 24px rgba(250,204,21,.4);z-index:90}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;display:none;align-items:center;justify-content:center;padding:1rem}
.modal.visible{display:flex}
.modal-content{background:#1e293b;border-radius:20px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;padding:1.5rem;border:1px solid #334155}
.modal-title{font-size:1.2rem;font-weight:700;margin-bottom:1.2rem;display:flex;justify-content:space-between;align-items:center}
.modal-close{background:transparent;border:none;color:#94a3b8;font-size:1.6rem;cursor:pointer;padding:0 .3rem}
.field{margin-bottom:1rem}
.field label{display:block;font-size:.78rem;color:#94a3b8;margin-bottom:.4rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.field input,.field textarea,.field select{width:100%;padding:.75rem .9rem;background:#273449;border:1px solid #334155;border-radius:10px;color:#f1f5f9;font-family:inherit;font-size:.9rem;outline:none}
.field select{cursor:pointer;-webkit-appearance:none;appearance:none;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%2394a3b8' d='M0 0l5 6 5-6z'/></svg>");background-repeat:no-repeat;background-position:right 1rem center;background-size:10px;padding-right:2.2rem}
.field textarea{min-height:140px;resize:vertical;line-height:1.5}
.audio-upload{border:2px dashed #334155;border-radius:10px;padding:1rem;text-align:center;cursor:pointer;background:#273449}
.audio-upload.has-file{border-color:#22c55e;background:rgba(34,197,94,.08)}
.audio-upload .icon{font-size:1.5rem;margin-bottom:.3rem;opacity:.7}
.audio-upload .text{font-size:.82rem;color:#94a3b8}
.audio-upload input{display:none}
.btn{width:100%;padding:.85rem;border-radius:10px;border:none;font-family:inherit;font-size:.95rem;font-weight:600;cursor:pointer;margin-top:.5rem}
.btn-primary{background:linear-gradient(135deg,#facc15,#fbbf24);color:#0f172a}
.btn-ai{background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff}
.btn-secondary{background:#273449;color:#f1f5f9;border:1px solid #334155}
.btn-danger{background:#ef4444;color:#fff}
.btn:disabled{opacity:.5;cursor:wait}
.ai-status{font-size:.8rem;text-align:center;padding:.6rem;border-radius:8px;margin-top:.5rem;background:#273449;color:#94a3b8;display:none}
.ai-status.visible{display:block}
.ai-status.loading{background:rgba(139,92,246,.2);color:#c4b5fd}
.ai-status.success{background:rgba(34,197,94,.2);color:#22c55e}
.ai-status.error{background:rgba(239,68,68,.2);color:#fca5a5}
.ai-status.warn{background:rgba(250,204,21,.15);color:#facc15}
.ai-hint{font-size:.72rem;color:#64748b;margin-top:.4rem;line-height:1.4}
.ai-hint a{color:#facc15;text-decoration:underline}
.ai-hint a:active{opacity:.6}
.lyrics-hint{font-size:.7rem;color:#64748b;margin-top:.4rem;line-height:1.4}
.player-view{position:fixed;inset:0;background:#0f172a;z-index:150;display:none;flex-direction:column;padding:1rem;overflow-y:auto}
.player-view.visible{display:flex}
.player-header{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid #334155}
.player-back{background:#1e293b;border:1px solid #334155;color:#f1f5f9;width:40px;height:40px;border-radius:50%;font-size:1.2rem;cursor:pointer;flex-shrink:0}
.player-title-block{flex:1;min-width:0}
.player-title{font-size:1.05rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.player-author{font-size:.78rem;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.panel{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:.9rem 1rem;margin-bottom:1rem}
.panel-title{font-size:.75rem;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.6rem}
.transpose-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}
.metro-bpm{font-size:1.5rem;font-weight:700;color:#facc15;text-align:center;flex:1;font-family:ui-monospace,monospace}
.metro-btn{background:#273449;border:1px solid #334155;color:#f1f5f9;width:40px;height:40px;border-radius:50%;font-size:1.1rem;cursor:pointer;font-weight:700}
.range{width:100%;height:6px;border-radius:3px;background:#273449;outline:none;-webkit-appearance:none;margin:.6rem 0}
.range::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:#facc15;cursor:pointer;border:2px solid #0f172a}
.lyrics{background:#1e293b;border-radius:14px;padding:1.5rem 1.2rem;margin-bottom:1rem;font-size:1.05rem;line-height:1.9;white-space:pre-wrap;overflow-y:auto;border:1px solid #334155;min-height:200px}
.audio-player{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:1rem;position:sticky;bottom:0;margin-bottom:.8rem}
.time-row{display:flex;justify-content:space-between;font-size:.72rem;color:#94a3b8;margin-bottom:.5rem}
.progress-bar{width:100%;height:6px;background:#273449;border-radius:3px;margin-bottom:.8rem;cursor:pointer;overflow:hidden}
.progress-fill{height:100%;background:#facc15;width:0%;transition:width .1s linear}
.controls-row{display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:.8rem}
.ctrl-btn{background:#273449;border:1px solid #334155;color:#f1f5f9;width:44px;height:44px;border-radius:50%;font-size:1.1rem;cursor:pointer}
.ctrl-btn.play{background:#facc15;color:#0f172a;width:56px;height:56px;font-size:1.4rem;border:none}
.speed-row{display:flex;justify-content:center;gap:.4rem;flex-wrap:wrap}
.speed-btn{padding:.35rem .7rem;border-radius:16px;background:#273449;border:1px solid #334155;color:#94a3b8;font-size:.75rem;cursor:pointer;font-weight:600}
.speed-btn.active{background:#facc15;color:#0f172a;border-color:#facc15}
.export-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}
.export-btn{padding:.75rem .4rem;background:#273449;border:1px solid #334155;color:#f1f5f9;border-radius:10px;cursor:pointer;font-family:inherit;font-size:.72rem;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:.3rem;transition:.15s;line-height:1.2}
.export-btn:active{background:#facc15;color:#0f172a;border-color:#facc15}
.export-btn .ex-icon{font-size:1.4rem}
.export-hint{font-size:.68rem;color:#64748b;margin-top:.5rem;text-align:center;font-style:italic}
.storage-info{background:#273449;border-radius:10px;padding:.7rem .9rem;font-size:.78rem;color:#94a3b8;display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem;flex-wrap:wrap}
.storage-info strong{color:#f1f5f9}
.toast{position:fixed;top:1.5rem;left:50%;transform:translateX(-50%) translateY(-100px);background:#1e293b;color:#f1f5f9;padding:.8rem 1.2rem;border-radius:10px;font-size:.85rem;font-weight:600;z-index:300;opacity:0;transition:.35s;border:1px solid #334155;max-width:90vw;text-align:center}
.toast.visible{transform:translateX(-50%) translateY(0);opacity:1}
.toast.error{background:#ef4444;border-color:#ef4444}
.toast.warn{background:#facc15;color:#0f172a;border-color:#facc15}
.hidden{display:none!important}
</style>
</head>
<body>
<header>
<h1>✝️ Puissant Gospels TV</h1>
<p class="subtitle">Apprendre, chanter, adorer</p>
<button class="settings-icon" id="sbtn">⚙️</button>
</header>
<div class="search-bar"><span>🔍</span><input type="text" id="search" placeholder="Rechercher…"></div>
<div class="tabs">
<div class="tab active" data-tab="all">📚 Tous</div>
<div class="tab" data-tab="fav">⭐ Favoris</div>
</div>
<div class="songs-list" id="list"></div>
<button class="fab" id="fab">＋</button>

<div class="modal" id="modal">
<div class="modal-content">
<div class="modal-title"><span id="mtitle">Ajouter un chant</span><button class="modal-close" id="mclose">×</button></div>
<div class="field"><label>Titre *</label><input type="text" id="f-title" placeholder="Ex: Que ma bouche chante"></div>
<div class="field"><label>Auteur</label><input type="text" id="f-author"></div>
<div class="field"><label>🌐 Langue de la chanson</label>
<select id="f-lang"></select>
<div class="lyrics-hint">💡 Choisissez la langue ou laissez « Détection automatique ». L'IA détectera et enregistrera automatiquement.</div>
</div>
<div class="field"><label>Audio (chanson à transcrire)</label>
<div class="audio-upload" id="audio-up">
<input type="file" id="f-audio" accept="audio/*">
<div class="icon">🎵</div>
<div class="text" id="audio-text">Appuyez pour ajouter l'audio</div>
</div>
</div>
<button class="btn btn-ai hidden" id="btranscribe">🎤 Transcrire & formater (Lead / Chœurs)</button>
<div class="ai-status" id="ai-status"></div>
<div class="field" style="margin-top:1rem"><label>Paroles *</label><textarea id="f-lyrics" placeholder="Les paroles apparaîtront ici après transcription, ou tapez-les manuellement.&#10;&#10;Format suggéré :&#10;Lead : première phrase du soliste&#10;Chœurs : réponse du chœur&#10;&#10;Lead : phrase suivante&#10;Chœurs : réponse du chœur"></textarea>
<div class="lyrics-hint">💡 L'IA distingue automatiquement le <strong>Lead</strong> (soliste) et les <strong>Chœurs</strong> (réponse collective). Vous pouvez toujours éditer après.</div>
</div>
<button class="btn btn-primary" id="bsave">💾 Enregistrer</button>
<button class="btn btn-danger hidden" id="bdel">🗑️ Supprimer</button>
</div></div>

<div class="modal" id="setmodal">
<div class="modal-content">
<div class="modal-title"><span>⚙️ Paramètres</span><button class="modal-close" id="sclose">×</button></div>
<div class="storage-info">
<div>📚 <strong id="st-count">0</strong> chant(s)</div>
<div>💾 <strong id="st-usage">—</strong></div>
</div>
<div class="field"><label>Clé API Groq (transcription + formatage IA)</label>
<input type="password" id="groqkey" placeholder="gsk_...">
<div class="ai-hint">
🔗 Créer / recréer une clé gratuite : <a href="https://console.groq.com/keys" target="_blank" rel="noopener">console.groq.com/keys</a><br>
<span style="opacity:.7">Gratuit — inscription par email ou Google</span>
</div>
</div>
<button class="btn btn-primary" id="saveset">💾 Enregistrer la clé</button>
<div style="text-align:center;font-size:.72rem;color:#64748b;margin-top:1rem">Puissant Gospels TV v3 — Pour la gloire de Dieu ✝️</div>
</div></div>

<div class="player-view" id="player">
<div class="player-header">
<button class="player-back" id="pback">←</button>
<div class="player-title-block"><div class="player-title" id="ptitle">Titre</div><div class="player-author" id="pauthor">Auteur</div></div>
<button class="player-back" id="pedit">✎</button>
</div>
<div class="panel">
<div class="panel-title">🥁 Métronome</div>
<div class="transpose-row"><button class="metro-btn" id="bdown">−</button><div class="metro-bpm" id="bval">90</div><button class="metro-btn" id="bup">＋</button></div>
<input type="range" class="range" id="brange" min="40" max="240" value="90">
<button class="btn btn-primary" id="mstart">▶ Démarrer le métronome</button>
</div>
<div class="lyrics" id="plyrics"></div>
<div class="panel">
<div class="panel-title">📤 Exporter les paroles</div>
<div class="export-grid">
<button class="export-btn" data-format="pdf"><span class="ex-icon">📄</span>PDF</button>
<button class="export-btn" data-format="word"><span class="ex-icon">📝</span>Word</button>
<button class="export-btn" data-format="gdocs"><span class="ex-icon">📋</span>Google Docs</button>
</div>
<div class="export-hint">PDF → téléchargement · Word → .doc · Docs → copie + ouverture</div>
</div>
<div class="audio-player">
<div class="time-row"><span id="pcur">0:00</span><span id="pdur">0:00</span></div>
<div class="progress-bar" id="pbar"><div class="progress-fill" id="pfill"></div></div>
<div class="controls-row">
<button class="ctrl-btn" id="brewind">⏪</button>
<button class="ctrl-btn play" id="bplay">▶</button>
<button class="ctrl-btn" id="bforward">⏩</button>
</div>
<div class="speed-row">
<button class="speed-btn" data-speed="0.5">0.5×</button>
<button class="speed-btn" data-speed="0.75">0.75×</button>
<button class="speed-btn" data-speed="1">1×</button>
<button class="speed-btn" data-speed="1.25">1.25×</button>
<button class="speed-btn" data-speed="1.5">1.5×</button>
</div>
</div>
<audio id="audio" preload="none"></audio>
</div>
<div class="toast" id="toast"></div>

<script>
/* ═══════════════════════════════════════════════════════════════
   CONSTANTES
   ═══════════════════════════════════════════════════════════════ */
var FK='pgtv_fav_v3',GK='pgtv_groq_key',MIG_FLAG='pgtv_idxdb_migrated_v1';
var DB_NAME='pgtv_v3',DB_VER=1;
var WHISPER_MODEL='whisper-large-v3-turbo';
var LLM_MODEL='llama-3.1-8b-instant';
var MAX_AUDIO_SIZE=24*1024*1024;

var LANGUAGES=[
{code:'',label:'🌐 Détection automatique'},
{code:'fr',label:'🇫🇷 Français'},
{code:'en',label:'🇬🇧 Anglais'},
{code:'es',label:'🇪🇸 Espagnol'},
{code:'pt',label:'🇵🇹 Portugais'},
{code:'de',label:'🇩🇪 Allemand'},
{code:'it',label:'🇮🇹 Italien'},
{code:'ht',label:'🇭🇹 Créole haïtien'},
{code:'ln',label:'🇨🇩 Lingala'},
{code:'sw',label:'🇰🇪 Swahili'},
{code:'yo',label:'🇳🇬 Yoruba'},
{code:'ig',label:'🇳🇬 Igbo'},
{code:'ha',label:'🇳🇬 Haoussa'},
{code:'wo',label:'🇸🇳 Wolof'},
{code:'bm',label:'🇲🇱 Bambara'},
{code:'ee',label:'🇹🇬 Ewé'},
{code:'tw',label:'🇬🇭 Twi'},
{code:'zu',label:'🇿🇦 Zoulou'},
{code:'xh',label:'🇿🇦 Xhosa'},
{code:'af',label:'🇿🇦 Afrikaans'},
{code:'am',label:'🇪🇹 Amharique'},
{code:'rw',label:'🇷🇼 Kinyarwanda'},
{code:'mg',label:'🇲🇬 Malgache'},
{code:'ar',label:'🇸🇦 Arabe'},
{code:'zh',label:'🇨🇳 Chinois'},
{code:'ja',label:'🇯🇵 Japonais'},
{code:'ko',label:'🇰🇷 Coréen'},
{code:'hi',label:'🇮🇳 Hindi'},
{code:'ru',label:'🇷🇺 Russe'},
{code:'nl',label:'🇳🇱 Néerlandais'},
{code:'pl',label:'🇵🇱 Polonais'},
{code:'tr',label:'🇹🇷 Turc'}
];

var LANG_EN={fr:'French',en:'English',es:'Spanish',pt:'Portuguese',de:'German',it:'Italian',ht:'Haitian Creole',ln:'Lingala',sw:'Swahili',yo:'Yoruba',ig:'Igbo',ha:'Hausa',wo:'Wolof',bm:'Bambara',ee:'Ewe',tw:'Twi',zu:'Zulu',xh:'Xhosa',af:'Afrikaans',am:'Amharic',rw:'Kinyarwanda',mg:'Malagasy',ar:'Arabic',zh:'Chinese',ja:'Japanese',ko:'Korean',hi:'Hindi',ru:'Russian',nl:'Dutch',pl:'Polish',tr:'Turkish'};

/* ═══════════════════════════════════════════════════════════════
   ÉTAT
   ═══════════════════════════════════════════════════════════════ */
var songs=[],favs=new Set(),tab='all',q='',editId=null,cur=null,editAudioBlob=null;
var ac=null,src=null,buf=null,useWA=false,waState={playing:false,start:0,paused:0,dur:0};
var curAudioUrl=null,curAudioBlob=null;
var bufCache=new Map();
var jsPDFLoaded=false;
var db=null;
var searchTimer=null;

/* ═══════════════════════════════════════════════════════════════
   UTILITAIRES
   ═══════════════════════════════════════════════════════════════ */
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function fmt(s){if(!s||isNaN(s))return'0:00';var m=Math.floor(s/60),x=Math.floor(s%60);return m+':'+(x<10?'0':'')+x}
function fmtBytes(b){if(!b)return'0 o';var k=1024,s=['o','Ko','Mo','Go'],i=Math.floor(Math.log(b)/Math.log(k));return(b/Math.pow(k,i)).toFixed(i?1:0)+' '+s[i]}
function toast(m,t){t=t||'success';var el=document.getElementById('toast');el.textContent=m;el.className='toast visible '+(t==='error'?'error':t==='warn'?'warn':'');clearTimeout(el._t);el._t=setTimeout(function(){el.className='toast '+(t==='error'?'error':t==='warn'?'warn':'')},3000)}
function langLabel(code){if(!code)return'';var l=LANGUAGES.find(function(x){return x.code===code});return l?l.label:'🌐 '+code.toUpperCase()}
function safeFilename(s){return String(s||'chant').replace(/[\\/:*?"<>|]/g,'').replace(/\s+/g,'_').slice(0,80)||'chant'}
function dataUriToBlob(uri,mime){var b=atob(uri.split(',')[1]);var ab=new ArrayBuffer(b.length);var ia=new Uint8Array(ab);for(var i=0;i<b.length;i++)ia[i]=b.charCodeAt(i);return new Blob([ab],{type:mime})}

/* ═══════════════════════════════════════════════════════════════
   INDEXEDDB — STOCKAGE RAPIDE
   ═══════════════════════════════════════════════════════════════ */
function openDB(){
return new Promise(function(resolve,reject){
if(db)return resolve(db);
var req=indexedDB.open(DB_NAME,DB_VER);
req.onupgradeneeded=function(e){
var d=e.target.result;
if(!d.objectStoreNames.contains('songs'))d.createObjectStore('songs',{keyPath:'id'});
if(!d.objectStoreNames.contains('audio'))d.createObjectStore('audio');
};
req.onsuccess=function(e){db=e.target.result;resolve(db)};
req.onerror=function(){reject(req.error)};
});
}
function dbGetAll(store){
return openDB().then(function(d){return new Promise(function(resolve,reject){
var tx=d.transaction(store,'readonly');
var req=tx.objectStore(store).getAll();
req.onsuccess=function(){resolve(req.result||[])};
req.onerror=function(){reject(req.error)};
})});
}
function dbGet(store,key){
return openDB().then(function(d){return new Promise(function(resolve,reject){
var tx=d.transaction(store,'readonly');
var req=tx.objectStore(store).get(key);
req.onsuccess=function(){resolve(req.result)};
req.onerror=function(){reject(req.error)};
})});
}
function dbPut(store,key,val){
return openDB().then(function(d){return new Promise(function(resolve,reject){
var tx=d.transaction(store,'readwrite');
var req=key!==undefined?tx.objectStore(store).put(val,key):tx.objectStore(store).put(val);
tx.oncomplete=function(){resolve()};
tx.onerror=function(){reject(tx.error)};
})});
}
function dbDelete(store,key){
return openDB().then(function(d){return new Promise(function(resolve,reject){
var tx=d.transaction(store,'readwrite');
tx.objectStore(store).delete(key);
tx.oncomplete=function(){resolve()};
tx.onerror=function(){reject(tx.error)};
})});
}
function dbDeleteBoth(id){
