function fetchWithRetry(url,options,maxRetries){
maxRetries=maxRetries||3;
var attempt=0;
function tryFetch(){
return fetch(url,options).then(function(r){
if((r.status===429||r.status>=500)&&attempt<maxRetries){
var wait=Math.pow(2,attempt)*1000;
attempt++;
return new Promise(function(res){setTimeout(res,wait)}).then(tryFetch);
}
return r;
}).catch(function(e){
if(attempt<maxRetries){
var wait=Math.pow(2,attempt)*1000;
attempt++;
return new Promise(function(res){setTimeout(res,wait)}).then(tryFetch);
}
throw e;
});
}
return tryFetch();
}

function formatLyricsWithLLM(rawText,key,langCode){
var langName=langCode&&LANG_EN[langCode]?LANG_EN[langCode]:null;
var langRule=langName
?'IMPORTANT: The song is in '+langName+'. Preserve ALL words exactly in '+langName+'. NEVER translate.'
:'IMPORTANT: Detect the original language and preserve ALL words in that original language. NEVER translate.';
var systemPrompt=
"You are an expert in Christian gospel songs. You receive a raw transcription. Your mission: reformat it distinguishing LEAD (soloist) and CHOIR (collective response or repeated refrain).\n\n"+
"STRICT RULES:\n"+
"1. The Lead opens and sings verses, with unique and varied phrases.\n"+
"2. The Choir responds with short, often repetitive phrases (Hallelujah, Amen, refrain).\n"+
"3. MANDATORY format with space before colon:\n"+
"   Lead : [soloist words]\n"+
"   Chœurs : [choir words]\n"+
"4. Empty line between each speaker turn.\n"+
"5. NEVER modify the original words. Only add the prefixes.\n"+
"6. If the whole song is in unison with no possible distinction, return the raw text WITHOUT prefix.\n"+
"7. "+langRule+"\n"+
"8. Return ONLY the reformatted text. No explanation, no comment, no header.\n\n"+
"EXPECTED OUTPUT EXAMPLE:\n\n"+
"Lead : Que ma bouche chante ta louange\n"+
"Chœurs : Alléluia, alléluia\n\n"+
"Lead : Que mon cœur te célèbre à jamais\n"+
"Chœurs : Alléluia, alléluia";

return fetchWithRetry('https://api.groq.com/openai/v1/chat/completions',{
method:'POST',
headers:{'Authorization':'Bearer '+key,'Content-Type':'application/json'},
body:JSON.stringify({
model:LLM_MODEL,
messages:[
{role:'system',content:systemPrompt},
{role:'user',content:'Raw transcription to reformat:\n\n'+rawText}
],
temperature:0.2,
max_tokens:4000
})
}).then(function(r){
if(!r.ok)return r.text().then(function(t){throw new Error('LLM HTTP '+r.status+' : '+t.slice(0,150))});
return r.json();
}).then(function(d){
if(d.choices&&d.choices[0]&&d.choices[0].message&&d.choices[0].message.content){
return d.choices[0].message.content.trim();
}
throw new Error('Réponse LLM invalide');
});
}

