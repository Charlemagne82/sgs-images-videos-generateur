   ═══════════════════════════════════════════════════════════════ */
function initAC(){if(ac)return true;try{ac=new(window.AudioContext||window.webkitAudioContext)();return true}catch(e){return false}}
function loadBufFromBlob(blob){
if(!initAC())return Promise.resolve(false);
return blob.arrayBuffer().then(function(ab){
return ac.decodeAudioData(ab);
}).then(function(b){buf=b;return true}).catch(function(){buf=null;return false});
}
function playWA(){if(!buf||!ac)return;if(ac.state==='suspended')ac.resume();var s=ac.createBufferSource();s.buffer=buf;s.connect(ac.destination);s.start(0,waState.paused);src=s;waState.playing=true;waState.start=ac.currentTime-waState.paused;waState.dur=buf.duration;startTick();updPlay()}
function pauseWA(){if(!waState.playing||!ac)return;waState.paused=ac.currentTime-waState.start;if(src){try{src.stop()}catch(e){}src=null}waState.playing=false;stopTick();updPlay()}
function stopWA(){if(src){try{src.stop()}catch(e){}src=null}waState.playing=false;waState.paused=0;stopTick();updPlay()}
var tick=null;
function startTick(){stopTick();tick=setInterval(function(){if(!waState.playing||!ac)return;var c=ac.currentTime-waState.start;updProg(c,waState.dur)},200)}
function stopTick(){if(tick){clearInterval(tick);tick=null}}
function updProg(c,d){document.getElementById('pcur').textContent=fmt(c);document.getElementById('pdur').textContent=fmt(d);document.getElementById('pfill').style.width=(d?Math.min(100,c/d*100):0)+'%'}
function updPlay(){var b=document.getElementById('bplay');var p=useWA?waState.playing:!document.getElementById('audio').paused;b.textContent=p?'⏸':'▶'}

function cleanupAudioUrl(){
if(curAudioUrl){try{URL.revokeObjectURL(curAudioUrl)}catch(e){}curAudioUrl=null}
curAudioBlob=null;
}

function openPlayer(id){
var s=songs.find(function(x){return x.id===id});
if(!s)return;
cur=s;
document.getElementById('ptitle').textContent=s.title;
document.getElementById('pauthor').textContent=(s.author||'Auteur inconnu')+(s.language?' · '+langLabel(s.language):'');
document.getElementById('plyrics').textContent=s.lyrics||'';
document.getElementById('player').className='player-view visible';
document.body.style.overflow='hidden';
cleanupAudioUrl();
stopWA();
buf=null;
useWA=false;
waState.paused=0;waState.playing=false;
updPlay();updProg(0,0);

if(bufCache.has(id)){
buf=bufCache.get(id);
useWA=true;
return;
}
getAudioDB(id).then(function(blob){
if(!blob)return;
curAudioBlob=blob;
curAudioUrl=URL.createObjectURL(blob);
return loadBufFromBlob(blob).then(function(ok){
if(ok){
bufCache.set(id,buf);
useWA=true;
}else{
useWA=false;
document.getElementById('audio').src=curAudioUrl;
}
});
}).catch(function(e){console.warn('Audio load',e)});
}
function closePlayer(){
stopWA();
var a=document.getElementById('audio');
a.pause();a.removeAttribute('src');a.load();
cleanupAudioUrl();
document.getElementById('player').className='player-view';
document.body.style.overflow='';
cur=null;buf=null;
}

/* ═══════════════════════════════════════════════════════════════
   MÉTRONOME
   ═══════════════════════════════════════════════════════════════ */
var metro={on:false,bpm:90,next:0,beat:0,timer:null};
function click(t,b){if(!ac)return;var o=ac.createOscillator(),g=ac.createGain();o.frequency.value=b===0?1200:800;o.type='sine';g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(b===0?.5:.3,t+.001);g.gain.exponentialRampToValueAtTime(.0001,t+.05);o.connect(g);g.connect(ac.destination);o.start(t);o.stop(t+.06)}
function sched(){if(!ac||!metro.on)return;while(metro.next<ac.currentTime+.12){click(metro.next,metro.beat);metro.next+=60/metro.bpm;metro.beat=(metro.beat+1)%4}metro.timer=setTimeout(sched,25)}
function startMetro(){if(!initAC()){toast('Audio non supporté','error');return}if(ac.state==='suspended')ac.resume();metro.on=true;metro.beat=0;metro.next=ac.currentTime+.05;document.getElementById('mstart').textContent='⏸ Arrêter';sched()}
function stopMetro(){metro.on=false;if(metro.timer){clearTimeout(metro.timer);metro.timer=null}document.getElementById('mstart').textContent='▶ Démarrer le métronome'}

/* ═══════════════════════════════════════════════════════════════
   STOCKAGE — INDICATEUR
   ═══════════════════════════════════════════════════════════════ */
function updateStorageInfo(){
document.getElementById('st-count').textContent=songs.length;
if(navigator.storage&&navigator.storage.estimate){
navigator.storage.estimate().then(function(est){
document.getElementById('st-usage').textContent=fmtBytes(est.usage||0)+' utilisés';
}).catch(function(){document.getElementById('st-usage').textContent='—'});
}else{
document.getElementById('st-usage').textContent='—';
}
}

/* ═══════════════════════════════════════════════════════════════
   ÉVÉNEMENTS
   ═══════════════════════════════════════════════════════════════ */
document.getElementById('sbtn').onclick=function(){
document.getElementById('groqkey').value=localStorage.getItem(GK)||'';
updateStorageInfo();
document.getElementById('setmodal').className='modal visible';
};
